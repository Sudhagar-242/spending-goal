<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js" defer></script>

<script async hidden>
  window.goal_discounts = {goals: {{ shop.metafields.spending_goal.goal_discounts.value | json }}};
  window.cart_currency = '{{ shop.currency }}';
  window.theme_name = '{{ shop.metafields["zuper-shipping-threshold"].theme_name.value }}';
  window.cart_toatal = {{ cart.total_price | divided_by: 100 }};
</script>

{% schema %}
{
  "name": "Inject cart drawer",
  "target": "body",
  "stylesheet": "inject-progress.css",
  "javascript": "inject-progress.js",
  "settings": []
}
{% endschema %}
