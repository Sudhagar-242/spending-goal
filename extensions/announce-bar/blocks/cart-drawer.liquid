<style>
  .sd-cart-container {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 9998;
  }
  .sd-cart-open {
    display: block;
  }
  .sd-cart-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    z-index: 1;
  }
  .sd-cart-drawer {
    position: absolute;
    top: 0;
    right: 0;
    width: 35%;
    height: 100%;
    background: #fff;
    border-radius: 18px 0 0 18px;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.12);
    padding: 32px 24px;
    font-family: 'Inter', Arial, sans-serif;
    color: #222;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    z-index: 2; /* Make sure drawer is above backdrop */
  }
  .sd-cart-drawer-title {
    font-size: 1.5rem;
    margin-bottom: 12px;
    font-weight: 600;
  }
  .sd-cart-drawer-list {
    list-style: none;
    padding: 0;
    margin: 0 0 18px 0;
  }
  .sd-cart-drawer-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 0;
    border-bottom: 1px solid #eee;
    font-size: 1rem;
  }
  .sd-cart-item-title {
    flex: 2;
    font-weight: 500;
  }
  .sd-cart-item-qty {
    flex: 1;
    text-align: center;
    color: #666;
  }
  .sd-cart-item-price {
    flex: 1;
    text-align: right;
    color: #10b981;
    font-weight: 600;
  }
  .sd-cart-total {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 18px 0;
    text-align: right;
  }
  .sd-cart-checkout-btn {
    display: block;
    width: 100%;
    background: #10b981;
    color: #fff;
    text-align: center;
    padding: 12px 0;
    border-radius: 8px;
    font-size: 1.1rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s;
    margin-top: 12px;
  }
  .sd-cart-checkout-btn:hover {
    background: #059669;
  }
  .sd-cart-drawer {
    position: fixed;
    top: 0;
    right: 0;
    width: 360px;
    height: 100vh;
    background: #fff;
    box-shadow: -4px 0 15px rgba(0, 0, 0, 0.2);
    padding: 1.5rem;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    z-index: 1001;
  }

  .sd-cart-close-btn {
    background: transparent;
    border: none;
    font-size: 2rem;
    font-weight: bold;
    color: #333;
    cursor: pointer;
    align-self: flex-end;
    padding: 0.25rem 0.5rem;
    line-height: 1;
  }

  .sd-cart-drawer-title {
    font-size: 1.8rem;
    margin: 0 0 0.5rem 0;
    font-weight: 700;
    color: #111;
  }

  .sd-cart-drawer p {
    font-size: 1rem;
    color: #555;
    margin: 0 0 1rem 0;
  }

  .sd-cart-drawer-list {
    list-style: none;
    margin: 0;
    padding: 0;
    flex-grow: 1;
    overflow-y: auto;
    border-top: 1px solid #eee;
    border-bottom: 1px solid #eee;
  }

  .sd-cart-drawer-item {
    display: flex;
    gap: 12px;
    padding: 1rem 0;
    border-bottom: 1px solid #f0f0f0;
  }

  .sd-cart-item-image {
    width: 64px;
    height: 64px;
    object-fit: contain;
    border: 1px solid #ddd;
    border-radius: 4px;
  }

