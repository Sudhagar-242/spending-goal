<div class="sd-cart-container" role="dialog" aria-labelledby="cart-title" aria-modal="true">
  <div class="sd-cart-drawer" role="document" aria-describedby="cart-description">
    <div style="display: flex; justify-content: space-between;">
      <h1 id="cart-title" class="sd-cart-drawer-title">Your Cart</h1>
      <button
        type="button"
        class="sd-cart-close-btn"
        aria-label="Close cart"
        style="padding: 2px 8px; font-size: 1.5rem; background: none; border: none; cursor: pointer;"
        onclick="closeCartDrawer()"
      >
        &times;
      </button>
    </div>
    <p id="cart-description">Review your items and proceed to checkout.</p>

    {% render 'progress-bar' %}

    {% if cart.item_count > 0 %}
      <ul class="sd-cart-drawer-list" id="cart-items-list">
        {% for item in cart.items %}
          <li class="sd-cart-drawer-item" data-line="{{ forloop.index }}">
            <img
              src="{{ item.image | img_url: 'small' }}"
              alt="{{ item.title }}"
              class="sd-cart-item-image"
              loading="lazy"
            >
            <div class="sd-cart-item-details">
              <p class="sd-cart-item-title">{{ item.product.title }}</p>
              {% if item.variant.title != 'Default Title' %}
                <p class="sd-cart-item-variant">Variant: {{ item.variant.title }}</p>
              {% endif %}
              {% if item.properties.size > blank %}
                <p class="sd-cart-item-property">Size: {{ item.properties.size }}</p>
              {% endif %}
              {% for p in item.properties %}
                {% unless p.first == '_note' or p.first == 'size' %}
                  <p class="sd-cart-item-property">{{ p.first }}: {{ p.last }}</p>
                {% endunless %}
              {% endfor %}

              <form method="post" action="/cart/change" class="sd-cart-qty-form" data-line="{{ forloop.index }}">
                <input type="hidden" name="id" value="{{ item.key }}">
                <label for="qty-{{ item.key }}" class="sr-only">Quantity for {{ item.title }}</label>
                <input
                  id="qty-{{ item.key }}"
                  class="sd-cart-item-qty-input"
                  type="number"
                  name="quantity"
                  min="0"
                  value="{{ item.quantity }}"
                  aria-live="polite"
                >
                <button type="submit" class="sd-cart-update-btn" aria-label="Update quantity">Update</button>
              </form>

              <button
                class="sd-cart-item-remove-btn"
                data-key="{{ item.key }}"
                aria-label="Remove {{ item.title }} from cart"
              >
                Remove
              </button>

              <span class="sd-cart-item-price">{{ item.line_price | money }}</span>
            </div>
          </li>
        {% endfor %}
      </ul>

      {% if cart.attributes.size > 0 or cart.note %}
        <div class="sd-cart-attributes">
          {% if cart.note %}
            <p><strong>Note:</strong> {{ cart.note }}</p>
          {% endif %}
          {% for attr in cart.attributes %}
            <p>
              <strong>{{ attr.first }}:</strong> {{ attr.last }}
            </p>
          {% endfor %}
        </div>
      {% endif %}

      {% if cart.discount_applications.size > 0 %}
        <div class="sd-cart-discounts">
          <h2>Discounts Applied</h2>
          <ul>
            {% for discount in cart.discount_applications %}
              <li>{{ discount.title }}: -{{ discount.description }}</li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}

      <form method="post" action="/cart/update" id="cart-note-form" class="sd-cart-note-form">
        <label for="cart-note">Add a note to your order:</label>
        <textarea id="cart-note" name="note" rows="3">{{ cart.note }}</textarea>
        <button type="submit" class="sd-cart-note-update-btn">Save Note</button>
      </form>

      <div class="sd-cart-summary">
        <p class="sd-cart-subtotal">Subtotal: {{ cart.subtotal_price | money }}</p>
        <p class="sd-cart-shipping">Shipping: Calculated at checkout</p>
        <p class="sd-cart-total">Total: {{ cart.total_price | money }}</p>
      </div>

      <a href="/checkout" class="sd-cart-checkout-btn" aria-label="Proceed to checkout">Checkout</a>

    {% else %}
      <div class="sd-cart-empty">
        <img src="{{ 'empty-cart.png' | asset_url }}" alt="Empty cart illustration" class="sd-cart-empty-image">
        <p>Your cart is empty.</p>
        <p>Start adding some products to your cart.</p>
      </div>
    {% endif %}
  </div>
  <div class="sd-cart-backdrop" tabindex="-1"></div>
</div>

<script>
  // AJAX remove item and quantity update (using fetch)
  document.querySelectorAll('.sd-cart-item-remove-btn').forEach((button) => {
    button.addEventListener('click', function () {
      const key = this.dataset.key;
      fetch('/cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: key, quantity: 0 }),
      })
        .then((response) => response.json())
        .then((data) => {
          // Update cart UI here or reload page as needed
          location.reload();
        });
    });
  });

  document.querySelectorAll('.sd-cart-qty-form').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      fetch('/cart/change.js', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: JSON.stringify({
          id: formData.get('id'),
          quantity: parseInt(formData.get('quantity')),
        }),
      })
        .then((res) => res.json())
        .then((data) => {
          // Update cart UI or reload
          location.reload();
        });
    });
  });

  // Cart note update form via AJAX
  document.getElementById('cart-note-form').addEventListener('submit', function (e) {
    e.preventDefault();
    const note = this.querySelector('textarea[name="note"]').value;
    fetch('/cart/update.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ note }),
    })
      .then((res) => res.json())
      .then((data) => {
        alert('Note updated');
      });
  });
</script>

